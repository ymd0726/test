{
  // Cloudflare Worker 設定。詳細: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jdem-stop-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],

  // McpAgent は Durable Object を1つ使う（無料プランで利用可能）
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "CreativeStopMCP"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CreativeStopMCP"]
    }
  ],

  // cr入稿くん: 長時間処理の自己連鎖（continuation）用。
  // Workerは自分の公開URLをfetchできない（edgeが404を返す）ため、自分自身へのService Bindingで直結する。
  "services": [
    { "binding": "SELF_WORKER", "service": "jdem-stop-mcp" }
  ],

  // 翌日自動チェックくん（TOOL-40）: 毎朝 7:30 JST（= 22:30 UTC）に前日分の
  // cr入稿くん/cr停止くん実行を Meta/集計表/Notion と照合する。
  // 手動テスト: GET /check/run?token=<SHARED_SECRET>&dryRun=1
  "triggers": {
    "crons": ["30 22 * * *"]
  },

  "vars": {
    // チェック結果サマリの投稿先（管理チャンネルのSlackチャンネルID）。
    // 未設定の間はチェック・BUG起票は動くがSlack投稿だけされない。/check/run の ?channel= で上書き可。
    "CHECK_SLACK_CHANNEL_ID": ""
  },

  // GAS_WEBAPP_URL と SHARED_SECRET は wrangler secret で設定する（README参照）。
  // ここには秘密情報を書かない。
  "observability": {
    "enabled": true
  }
}
